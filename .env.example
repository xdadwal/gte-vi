APP_ENV=development
DATABASE_URL=postgres://gte:local-only@127.0.0.1:55432/gte?sslmode=disable
REDIS_URL=redis://127.0.0.1:56379
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Exact extra preview origins; ignored outside APP_ENV=development.
DEV_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
OWNER_EMAIL=owner@example.test
# Only used in development. Set a local secret; never enable in production.
DEV_AUTH_TOKEN=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
GRAPH_DIR=artifacts/routing
WEB_DIR=web/dist
LISTEN_ADDR=127.0.0.1:8080

# Only trust a proxy that replaces X-Real-IP. Leave empty for direct traffic.
TRUSTED_PROXY_CIDRS=
NETWORK_RATE_PER_MINUTE=300

# all for local development; api/gateway/worker for separate scaling.
APP_ROLE=all
